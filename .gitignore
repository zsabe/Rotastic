# ROTASTIC / PHCC repository safeguards
# Source code belongs in GitHub; PHCC production data, credentials and exports do not.

# Environment and privileged credentials
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Database backups / production exports
backups/
exports/
production-data/
private-data/
*.dump
*.backup
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Supabase/local tooling state
supabase/.temp/
.supabase/

# Android local machine/build secrets
android-app/local.properties
android-app/**/local.properties
android-app/**/keystore.properties

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
